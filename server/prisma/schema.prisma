  @@map("transfer_items")
}

model StockCount {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  companyId     String           @db.ObjectId
  branchId      String           @db.ObjectId
  priceGroupId  String?          @db.ObjectId
  countNo       String
  status        StockCountStatus @default(DRAFT)
  notes         String?
  createdById   String           @db.ObjectId
  committedById String?          @db.ObjectId
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch      Branch           @relation(fields: [branchId], references: [id])
  priceGroup  PriceGroup?      @relation(fields: [priceGroupId], references: [id])
  createdBy   User             @relation("StockCountCreatedBy", fields: [createdById], references: [id])
  committedBy User?            @relation("StockCountCommittedBy", fields: [committedById], references: [id])
  items       StockCountItem[]

  @@unique([companyId, countNo])
  @@index([companyId, branchId, status])
  @@index([companyId, createdAt])
