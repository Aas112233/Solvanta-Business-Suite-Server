  companyId      String   @db.ObjectId
  branchId       String   @db.ObjectId
  vendorName     String
  invoiceNo      String?
  date           DateTime @default(now())
  totalAmount    Float
  paymentMethod  String // CASH, BANK, CREDIT
  status         String   @default("DRAFT") // DRAFT, POSTED, PAID
