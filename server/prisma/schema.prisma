// ══════════════════════════════════════════════════════════════
// SERVICE MASTER (Non-inventory services)
// ══════════════════════════════════════════════════════════════

model ServiceMaster {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId           String   @db.ObjectId
  code                String
  name                String
  description         String?
  category            String?  // Repair, Installation, Maintenance, Support, etc.
  standardRate        Float
  costRate            Float?   // Your cost (technician salary, etc.)
  incomeAccountId     String?  @db.ObjectId
  expenseAccountId    String?  @db.ObjectId
  duration            Int?     // Estimated time in minutes
  isLabor             Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
