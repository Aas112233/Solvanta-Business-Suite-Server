// ─── Prisma Schema: SOLVANTA CRM + ERP + POS + Accounting (MongoDB) ───
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════════════════════

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductKind {
  MERCHANDISE
  RAW_MATERIAL
  FINISHED_GOOD
  SEMI_FINISHED
  CONSUMABLE
}

enum TaxType {
  SALES
  PURCHASE
  BOTH
}

enum StockMovementType {
  PURCHASE_RECEIPT
  POS_SALE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  DAMAGE
  EXPIRED
  RETURN
  PRODUCTION_ISSUE
  PRODUCTION_RECEIPT
}

enum PaymentMethod {
  CASH
  CARD
  MIXED
  CREDIT
  BANK_TRANSFER
}

enum InvoiceStatus {
  PAID
  PARTIAL
  CREDIT
  VOID
  REFUNDED
  UNPOSTED
}

enum SalesReturnStatus {
  POSTED
  VOID
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  PARTIAL
  PAID
  CANCELLED
}

enum PurchaseReturnStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  ORDERED
  RECEIVED
  PARTIAL
  CANCELLED
}

enum PurchasePaymentStatus {
  POSTED
  VOID
}

enum TransferStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum PartyType {
  CUSTOMER
  SUPPLIER
}

enum AccountMappingType {
  INVENTORY_ASSET
  COGS_EXPENSE
  SALES_REVENUE
  SALES_RETURN
  OUTPUT_TAX
  INPUT_TAX
  CASH
  BANK
  ACCOUNT_PAYABLE
  ACCOUNT_RECEIVABLE
  PURCHASE_RETURN
  EXPENSE
  DISCOUNT_GIVEN
  DISCOUNT_RECEIVED
  SHRINKAGE_EXPENSE
  DAMAGED_GOODS_EXPENSE
  TRANSFER_IN_TRANSIT
  WIP_ASSET
  PRODUCTION_VARIANCE
}

enum BOMStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductionOrderStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AccountEntityType {
  GLOBAL
  BRANCH
  PRODUCT
  CATEGORY
  CUSTOMER
  SUPPLIER
}

enum StockCountStatus {
  DRAFT
  PENDING
  COMMITTED
  CANCELLED
}

enum POSShiftStatus {
  OPEN
  CLOSED
}

enum SalesQuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  REJECTED
  CONVERTED
  CANCELLED
}

enum CashCollectionRunStatus {
  DRAFT
  IN_PROGRESS
  CLOSED
  CANCELLED
}

enum CashCollectionBagStatus {
  DECLARED
  PICKUP_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  VAULT_RECEIVED
  DEPOSITED
  RECONCILED
  SHORT
  EXCESS
  LOST
  CANCELLED
}

enum PayrollPaymentStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

// ══════════════════════════════════════════════════════════════
// COMPANY & BRANCH
// ══════════════════════════════════════════════════════════════

model Company {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  vatNumber String?
  currency  String   @default("SAR")
  settings  Json
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches             Branch[]
  users                User[]
  roles                Role[]
  customers            Customer[]
  suppliers            Supplier[]
  categories           Category[]
  brands               Brand[]
  itemGroups           ItemGroup[]
  unitMasters          UnitMaster[]
  products             Product[]
  taxes                Tax[]
  priceGroups          PriceGroup[]
  accounts             Account[]
  accountMappings      AccountMapping[]
  journalEntries       JournalEntry[]
  posInvoices          POSInvoice[]
  salesReturns         SalesReturn[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseReturns      PurchaseReturn[]
  purchasePayments     PurchasePayment[]
  transfers            Transfer[]
  inventoryStocks      InventoryStock[]
  stockMovements       StockMovement[]
  expenses             Expense[]
  periodCloses         PeriodClose[]
  stockCounts          StockCount[]
  auditLogs            AuditLog[]
  globalStrings        GlobalString[]
  documentCounters     DocumentCounter[]
  posTerminals         POSTerminal[]
  posShifts            POSShift[]
  purchaseOrders       PurchaseOrder[]
  salesQuotations      SalesQuotation[]
  salesOrders          SalesOrder[]
  cashCollectionRuns   CashCollectionRun[]
  cashCollectionBags   CashCollectionBag[]
  cashBankDeposits     CashBankDeposit[]
  cashCollectionEvents CashCollectionEvent[]
  loyaltyCustomers     LoyaltyCustomer[]
  loyaltyPointHistory  LoyaltyPointHistory[]
  hrDepartments        Department[]
  hrPositions          Position[]
  hrEmployees          Employee[]
  expensePurchases     ExpensePurchase[]
  serviceMasters       ServiceMaster[]
  bankAccounts         BankAccount[]
  bankTransactions     BankTransaction[]
  bankReconciliations  BankReconciliation[]
  bankStatementImports BankStatementImport[]
  payrollPayments      PayrollPayment[]
  boms                 Bom[]
  productionOrders     ProductionOrder[]
  productionConsumptions ProductionMaterialConsumption[]
  productionCompletions ProductionCompletion[]

  defaultTaxAccountId String?      @db.ObjectId
  shifts              Shift[]
  attendances         Attendance[]
  leaveTypes          LeaveType[]
  leaves              Leave[]

  @@index([createdAt])
  @@map("companies")
}

model DocumentCounter {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId  String   @db.ObjectId
  scope      String
  scopeKey   String   @default("global")
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, scope, scopeKey])
  @@map("document_counters")
}

model Branch {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @db.ObjectId
  name      String
  code      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userBranches         UserBranch[]
  inventoryStocks      InventoryStock[]
  stockMovements       StockMovement[]
  posInvoices          POSInvoice[]
  salesReturns         SalesReturn[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseReturns      PurchaseReturn[]
  purchasePayments     PurchasePayment[]
  journalEntries       JournalEntry[]
  journalCostCenters   JournalEntry[]        @relation("JournalEntryCostCenter")
  expenses             Expense[]
  transfersFrom        Transfer[]            @relation("TransferFrom")
  transfersTo          Transfer[]            @relation("TransferTo")
  stockCounts          StockCount[]
  auditLogs            AuditLog[]
  posTerminals         POSTerminal[]
  purchaseOrders       PurchaseOrder[]
  salesQuotations      SalesQuotation[]
  salesOrders          SalesOrder[]
  cashCollectionBags   CashCollectionBag[]
  cashCollectionEvents CashCollectionEvent[]
  hrEmployees          Employee[]
  expensePurchases     ExpensePurchase[]
  attendances          Attendance[]
  bankAccounts         BankAccount[]
  payrollPayments      PayrollPayment[]
  productionOrders     ProductionOrder[]
  productionConsumptions ProductionMaterialConsumption[]
  productionCompletions ProductionCompletion[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

// ══════════════════════════════════════════════════════════════
// USER & ROLE (RBAC)
// ══════════════════════════════════════════════════════════════

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String   @db.ObjectId
  name        String
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users   User[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  companyId    String    @db.ObjectId
  email        String    @unique
  phone        String?
  name         String
  passwordHash String
  roleId       String    @db.ObjectId
  isActive     Boolean   @default(true)
  refreshToken String?
  lastLoginAt  DateTime?
  // Security fields
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  forcePasswordChange Boolean   @default(false)
  passwordResetToken  String?
  passwordResetExpiresAt DateTime?
  deletedAt           DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role                 Role                  @relation(fields: [roleId], references: [id])
  branches             UserBranch[]
  posInvoices          POSInvoice[]          @relation("CreatedBy")
  salesReturns         SalesReturn[]         @relation("SalesReturnCreatedBy")
  purchaseInvoices     PurchaseInvoice[]     @relation("PurchaseCreatedBy")
  purchaseReturns      PurchaseReturn[]      @relation("PurchaseReturnCreatedBy")
  purchasePayments     PurchasePayment[]     @relation("PurchasePaymentCreatedBy")
  stockMovements       StockMovement[]       @relation("MovementCreatedBy")
  journalEntries       JournalEntry[]        @relation("JournalPostedBy")
  expenses             Expense[]             @relation("ExpenseCreatedBy")
  periodCloses         PeriodClose[]         @relation("PeriodClosedBy")
  transfersCreated     Transfer[]            @relation("TransferCreatedBy")
  transfersApproved    Transfer[]            @relation("TransferApprovedBy")
  stockCountsCreated   StockCount[]          @relation("StockCountCreatedBy")
  stockCountsCommitted StockCount[]          @relation("StockCountCommittedBy")
  auditLogs            AuditLog[]
  posShifts            POSShift[]            @relation("ShiftUser")
  purchaseOrders       PurchaseOrder[]       @relation("PurchaseOrderCreatedBy")
  posTerminals         POSTerminal[]         @relation("TerminalDefaultUser")
  salesQuotations      SalesQuotation[]      @relation("QuotationCreatedBy")
  salesOrders          SalesOrder[]          @relation("SalesOrderCreatedBy")
  cashRunsCreated      CashCollectionRun[]   @relation("CashRunCreatedBy")
  cashRunsCollected    CashCollectionRun[]   @relation("CashRunCollector")
  cashBagsCreated      CashCollectionBag[]   @relation("CashBagCreatedBy")
  cashBagsPicked       CashCollectionBag[]   @relation("CashBagPickedBy")
  cashBagsVaulted      CashCollectionBag[]   @relation("CashBagVaultedBy")
  cashBagsDeposited    CashCollectionBag[]   @relation("CashBagDepositedBy")
  cashBagsReconciled   CashCollectionBag[]   @relation("CashBagReconciledBy")
  cashDeposits         CashBankDeposit[]     @relation("CashDepositCreatedBy")
  cashCollectionEvents CashCollectionEvent[] @relation("CashEventActor")
  expensePurchases     ExpensePurchase[]     @relation("ExpensePurchaseCreatedBy")
  hrLeavesApproved     Leave[]               @relation("LeaveApprovedBy")
  bankTransactions     BankTransaction[]     @relation("BankTransactionCreatedBy")
  reconciliationsPrepared BankReconciliation[] @relation("ReconciliationPreparedBy")
  reconciliationsReviewed BankReconciliation[] @relation("ReconciliationReviewedBy")
  bankStatementImports BankStatementImport[] @relation("BankStatementImportedBy")
  bomsCreated          Bom[]                 @relation("BomCreatedBy")
  productionOrdersCreated ProductionOrder[]  @relation("ProductionOrderCreatedBy")
  productionConsumptions ProductionMaterialConsumption[] @relation("ProductionConsumptionCreatedBy")
  productionCompletions ProductionCompletion[] @relation("ProductionCompletionCreatedBy")

  @@index([companyId, email])
  @@map("users")
}

model UserBranch {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  userId   String @db.ObjectId
  branchId String @db.ObjectId

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("user_branches")
}

// ══════════════════════════════════════════════════════════════
// CRM: CUSTOMER & SUPPLIER
// ══════════════════════════════════════════════════════════════

model Customer {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  companyId        String    @db.ObjectId
  customerCode     String
  name             String
  phone            String?
  email            String?
  vatNumber        String?
  address          Json?
  creditLimit      Float     @default(0)
  allowCreditSales Boolean   @default(true)
  openingBalance   Float     @default(0)
  priceGroupId     String?   @db.ObjectId
  tags             String[]
  notes            String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceGroup      PriceGroup?      @relation(fields: [priceGroupId], references: [id])
  posInvoices     POSInvoice[]
  salesReturns    SalesReturn[]
  salesQuotations SalesQuotation[]
  salesOrders     SalesOrder[]

  @@unique([companyId, customerCode])
  @@index([companyId, deletedAt])
  @@map("customers")
}

model Supplier {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  companyId      String    @db.ObjectId
  supplierCode   String
  name           String
  phone          String?
  vatNumber      String?
  address        Json?
  openingBalance Float     @default(0)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseInvoices PurchaseInvoice[]
  purchaseOrders   PurchaseOrder[]
  purchaseReturns  PurchaseReturn[]
  purchasePayments PurchasePayment[]

  @@unique([companyId, supplierCode])
  @@index([companyId, deletedAt])
  @@map("suppliers")
}

// ══════════════════════════════════════════════════════════════
// PRODUCT CATALOG & TAXES
// ══════════════════════════════════════════════════════════════

model Tax {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @db.ObjectId
  name      String
  rate      Float // e.g. 0.15 for 15%
  type      TaxType  @default(BOTH)
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("taxes")
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @db.ObjectId
  name      String
  parentId  String?  @db.ObjectId
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("categories")
}

model ItemGroup {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @db.ObjectId
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("item_groups")
}

model Brand {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @db.ObjectId
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("brands")
}

model UnitMaster {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId            String   @db.ObjectId
  name                 String
  defaultQtyInBaseUnit Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("unit_masters")
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String   @db.ObjectId
  itemCode    String // 16 digits
  name        String
  nameArabic  String?
  categoryId  String?  @db.ObjectId
  itemGroupId String?  @db.ObjectId
  brandId     String?  @db.ObjectId
  barcodes    String[]
  kind        ProductKind @default(MERCHANDISE)

  taxId     String?       @db.ObjectId
  taxRate   Float         @default(0.15) // Legacy field, keeping for fallback
  status    ProductStatus @default(ACTIVE)
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category             Category?             @relation(fields: [categoryId], references: [id])
  itemGroup            ItemGroup?            @relation(fields: [itemGroupId], references: [id])
  brand                Brand?                @relation(fields: [brandId], references: [id])
  tax                  Tax?                  @relation(fields: [taxId], references: [id])
  units                ProductUnit[]
  priceGroupPrices     ProductPriceGroup[]
  inventoryStocks      InventoryStock[]
  stockMovements       StockMovement[]
  posInvoiceItems      POSInvoiceItem[]
  salesReturnItems     SalesReturnItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  purchaseOrderItem    PurchaseOrderItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  transferItems        TransferItem[]
  stockCountItems      StockCountItem[]
  salesQuotationItems  SalesQuotationItem[]
  salesOrderItems      SalesOrderItem[]
  bomDefinitions       Bom[]                         @relation("BomFinishedGood")
  bomComponents        BomItem[]                     @relation("BomComponent")
  productionOrders     ProductionOrder[]             @relation("ProductionFinishedGood")
  productionMaterials  ProductionOrderMaterial[]     @relation("ProductionMaterialProduct")
  productionConsumptions ProductionMaterialConsumption[] @relation("ProductionConsumptionProduct")
  productionCompletions ProductionCompletion[]       @relation("ProductionCompletionProduct")

  @@unique([companyId, itemCode])
  @@index([companyId, deletedAt])
  @@index([companyId, status])
  @@index([companyId, status, deletedAt])
  @@index([companyId, kind])
  @@index([companyId, categoryId, status])
  @@index([companyId, itemGroupId, status])
  @@map("products")
}

model Bom {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  companyId      String    @db.ObjectId
  productId      String    @db.ObjectId
  name           String
  version        String    @default("1.0")
  status         BOMStatus @default(DRAFT)
  outputQty      Float     @default(1)
  outputUnitCode String
  notes          String?
  createdById    String    @db.ObjectId
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product        Product   @relation("BomFinishedGood", fields: [productId], references: [id])
  createdBy      User      @relation("BomCreatedBy", fields: [createdById], references: [id])
  items          BomItem[]
  orders         ProductionOrder[]

  @@unique([companyId, productId, version])
  @@index([companyId, status])
  @@map("boms")
}

model BomItem {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  bomId        String   @db.ObjectId
  productId    String   @db.ObjectId
  unitCode     String
  qtyRequired  Float
  scrapPercent Float    @default(0)
  notes        String?

  bom          Bom      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product      Product  @relation("BomComponent", fields: [productId], references: [id])

  @@index([bomId])
  @@index([productId])
  @@map("bom_items")
}

model ProductionOrder {
  id               String                @id @default(auto()) @map("_id") @db.ObjectId
  companyId        String                @db.ObjectId
  branchId         String                @db.ObjectId
  bomId            String                @db.ObjectId
  productId        String                @db.ObjectId
  productionNo     String
  date             DateTime              @default(now())
  status           ProductionOrderStatus @default(DRAFT)
  plannedQty       Float
  plannedUnitCode  String
  completedQty     Float                 @default(0)
  scrapQty         Float                 @default(0)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  notes            String?
  createdById      String                @db.ObjectId
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  company          Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch           Branch                @relation(fields: [branchId], references: [id])
  bom              Bom                   @relation(fields: [bomId], references: [id])
  product          Product               @relation("ProductionFinishedGood", fields: [productId], references: [id])
  createdBy        User                  @relation("ProductionOrderCreatedBy", fields: [createdById], references: [id])
  materials        ProductionOrderMaterial[]
  consumptions     ProductionMaterialConsumption[]
  completions      ProductionCompletion[]

  @@unique([companyId, productionNo])
  @@index([companyId, branchId, status, createdAt])
  @@index([companyId, productId, status])
  @@map("production_orders")
}

model ProductionOrderMaterial {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  productionOrderId String          @db.ObjectId
  productId         String          @db.ObjectId
  unitCode          String
  plannedQty        Float
  issuedQty         Float           @default(0)
  varianceQty       Float           @default(0)

  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product           Product         @relation("ProductionMaterialProduct", fields: [productId], references: [id])

  @@index([productionOrderId])
  @@map("production_order_materials")
}

model ProductionMaterialConsumption {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  companyId         String          @db.ObjectId
  branchId          String          @db.ObjectId
  productionOrderId String          @db.ObjectId
  productId         String          @db.ObjectId
  unitCode          String
  qtyConsumed       Float
  cost              Float           @default(0)
  batchNo           String?
  notes             String?
  createdById       String          @db.ObjectId
  createdAt         DateTime        @default(now())

  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch            Branch          @relation(fields: [branchId], references: [id])
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product           Product         @relation("ProductionConsumptionProduct", fields: [productId], references: [id])
  createdBy         User            @relation("ProductionConsumptionCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, productionOrderId, createdAt])
  @@map("production_material_consumptions")
}

model ProductionCompletion {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  companyId         String          @db.ObjectId
  branchId          String          @db.ObjectId
  productionOrderId String          @db.ObjectId
  productId         String          @db.ObjectId
  unitCode          String
  qtyCompleted      Float
  unitCost          Float           @default(0)
  notes             String?
  createdById       String          @db.ObjectId
  createdAt         DateTime        @default(now())

  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch            Branch          @relation(fields: [branchId], references: [id])
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product           Product         @relation("ProductionCompletionProduct", fields: [productId], references: [id])
  createdBy         User            @relation("ProductionCompletionCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, productionOrderId, createdAt])
  @@map("production_completions")
}

model ProductUnit {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  productId         String   @db.ObjectId
  unitName          String
  unitCode          String
  qtyInBaseUnit           Float    @default(1)
  salePrice               Float    @default(0)
  minimumNegotiationPrice Float?
  costPrice               Float    @default(0)
  barcodes          String[]
  isDefaultSaleUnit Boolean  @default(false)
  isBase            Boolean  @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, unitCode])
  @@index([productId])
  @@index([barcodes])
  @@map("product_units")
}

model PriceGroup {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @db.ObjectId
  name      String
  code      String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productPriceGroups ProductPriceGroup[]
  customers          Customer[]
  posTerminals       POSTerminal[]
  stockCounts        StockCount[]

  @@unique([companyId, name])
  @@map("price_groups")
}

model ProductPriceGroup {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  productId    String @db.ObjectId
  priceGroupId String @db.ObjectId
  unitCode                String
  salePrice               Float
  minimumNegotiationPrice Float?

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceGroup PriceGroup @relation(fields: [priceGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, priceGroupId, unitCode])
  @@map("product_price_groups")
}

// ══════════════════════════════════════════════════════════════
// INVENTORY
// ══════════════════════════════════════════════════════════════

model InventoryStock {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String @db.ObjectId
  branchId  String @db.ObjectId
  productId String @db.ObjectId
  unitCode  String
  qtyOnHand Float  @default(0)
  avgCost   Float  @default(0)

  minStock Float @default(5)
  maxStock Float @default(100)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
  @@index([companyId])
  @@index([companyId, productId])
  @@index([companyId, branchId])
  @@map("inventory_stocks")
}

model StockMovement {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  companyId     String            @db.ObjectId
  branchId      String            @db.ObjectId
  type          StockMovementType
  referenceId   String?
  referenceType String?
  productId     String            @db.ObjectId
  unitCode      String
  qty           Float
  cost          Float             @default(0)
  price         Float             @default(0)

  createdById String   @db.ObjectId
  createdAt   DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch  @relation(fields: [branchId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation("MovementCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, productId])
  @@index([companyId, branchId, createdAt])
  @@index([companyId, branchId, productId, unitCode, createdAt])
  @@index([companyId, referenceType, referenceId, type, createdAt])
  @@index([createdAt])
  @@map("stock_movements")
}

// ══════════════════════════════════════════════════════════════
// POS INVOICES
// ══════════════════════════════════════════════════════════════

model POSInvoice {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  companyId       String        @db.ObjectId
  branchId        String        @db.ObjectId
  invoiceNo       String
  customerId      String?       @db.ObjectId
  posTerminalId   String?       @db.ObjectId
  posShiftId      String?       @db.ObjectId
  salesOrderId    String?       @db.ObjectId
  clientRequestId String?
  subtotal        Float
  discountTotal   Float         @default(0)
  taxTotal        Float         @default(0)
  grandTotal      Float
  paymentMethod   String
  cashReceived    Float         @default(0)
  changeGiven     Float         @default(0)
  status          InvoiceStatus @default(PAID)
  isPosted        Boolean       @default(true)
  notes           String?
  createdById     String        @db.ObjectId
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  loyaltyCustomerId     String? @db.ObjectId
  loyaltyPointsEarned   Float?  @default(0)
  loyaltyPointsRedeemed Float?  @default(0)

  // Walk-in customer fields (for service invoices without customer record)
  walkInCustomerName  String?
  walkInPhone         String?

  company             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch              Branch                @relation(fields: [branchId], references: [id])
  customer            Customer?             @relation(fields: [customerId], references: [id])
  createdBy           User                  @relation("CreatedBy", fields: [createdById], references: [id])
  posTerminal         POSTerminal?          @relation(fields: [posTerminalId], references: [id])
  posShift            POSShift?             @relation(fields: [posShiftId], references: [id])
  salesOrder          SalesOrder?           @relation(fields: [salesOrderId], references: [id])
  loyaltyCustomer     LoyaltyCustomer?      @relation(fields: [loyaltyCustomerId], references: [id])
  loyaltyPointHistory LoyaltyPointHistory[]
  items               POSInvoiceItem[]
  returns             SalesReturn[]

  @@unique([companyId, invoiceNo])
  @@index([companyId, createdAt])
  @@index([companyId, branchId, createdAt])
  @@index([companyId, status, createdAt])
  @@index([customerId])
  @@index([posShiftId])
  @@index([salesOrderId])
  @@index([companyId, clientRequestId])
  @@map("pos_invoices")
}

model POSInvoiceItem {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId String @db.ObjectId
  productId String? @db.ObjectId  // Null for service items
  serviceId String? @db.ObjectId  // Null for product items
  serviceName String?  // For manual service entry
  serviceCode String?  // Service code for manual entry
  unitCode  String
  qty       Float
  unitPrice Float
  discount  Float  @default(0)
  taxAmount Float  @default(0)
  lineTotal Float

  invoice     POSInvoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product?          @relation(fields: [productId], references: [id])
  service     ServiceMaster?    @relation(fields: [serviceId], references: [id])
  returnItems SalesReturnItem[]

  @@map("pos_invoice_items")
}

// ══════════════════════════════════════════════════════════════
// LOYALTY & WALK-IN CUSTOMERS
// ══════════════════════════════════════════════════════════════

enum LoyaltyPointType {
  EARNED
  REDEEMED
  ADJUSTMENT
}

model LoyaltyCustomer {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId     String   @db.ObjectId
  name          String
  phone         String
  pointsBalance Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices     POSInvoice[]
  pointHistory LoyaltyPointHistory[]

  @@unique([companyId, phone])
  @@index([companyId, name])
  @@map("pos_loyalty_customers")
}

model LoyaltyPointHistory {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  companyId    String           @db.ObjectId
  customerId   String           @db.ObjectId
  invoiceId    String?          @db.ObjectId
  pointsChange Float
  type         LoyaltyPointType
  notes        String?
  createdAt    DateTime         @default(now())

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer LoyaltyCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice  POSInvoice?     @relation(fields: [invoiceId], references: [id])

  @@index([companyId, customerId])
  @@map("pos_loyalty_point_history")
}

// ══════════════════════════════════════════════════════════════
// POS TERMINALS & SHIFTS
// ══════════════════════════════════════════════════════════════

model POSTerminal {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId     String   @db.ObjectId
  code          String
  name          String
  branchId      String   @db.ObjectId
  defaultUserId String?  @db.ObjectId
  priceGroupId  String?  @db.ObjectId
  receiptHeader String?
  receiptFooter String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch      Branch       @relation(fields: [branchId], references: [id])
  defaultUser User?        @relation("TerminalDefaultUser", fields: [defaultUserId], references: [id])
  priceGroup  PriceGroup?  @relation(fields: [priceGroupId], references: [id])
  shifts      POSShift[]
  invoices    POSInvoice[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("pos_terminals")
}

model POSShift {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  companyId         String         @db.ObjectId
  terminalId        String         @db.ObjectId
  userId            String         @db.ObjectId
  openedAt          DateTime       @default(now())
  closedAt          DateTime?
  openingCash       Float          @default(0)
  expectedCash      Float?
  actualCash        Float?
  variance          Float?
  totalSales        Float?
  totalRefunds      Float?
  totalTransactions Int?
  denominations     Json?
  notes             String?
  status            POSShiftStatus @default(OPEN)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  terminal POSTerminal  @relation(fields: [terminalId], references: [id])
  user     User         @relation("ShiftUser", fields: [userId], references: [id])
  invoices POSInvoice[]

  @@index([companyId, terminalId])
  @@index([companyId, userId])
  @@index([openedAt])
  @@map("pos_shifts")
}

model CashCollectionRun {
  id          String                  @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String                  @db.ObjectId
  runNo       String
  status      CashCollectionRunStatus @default(IN_PROGRESS)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  collectorId String?                 @db.ObjectId
  notes       String?
  createdById String                  @db.ObjectId
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  collector User?                 @relation("CashRunCollector", fields: [collectorId], references: [id])
  createdBy User                  @relation("CashRunCreatedBy", fields: [createdById], references: [id])
  bags      CashCollectionBag[]
  events    CashCollectionEvent[]

  @@unique([companyId, runNo])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@map("cash_collection_runs")
}

model CashCollectionBag {
  id                String                  @id @default(auto()) @map("_id") @db.ObjectId
  companyId         String                  @db.ObjectId
  runId             String                  @db.ObjectId
  branchId          String                  @db.ObjectId
  bagCode           String
  sourceShiftId     String?                 @db.ObjectId
  declaredAmount    Float
  collectedAmount   Float?
  vaultAmount       Float?
  depositedAmount   Float?
  varianceAmount    Float?
  status            CashCollectionBagStatus @default(PICKUP_ASSIGNED)
  notes             String?
  pickedAt          DateTime?
  vaultReceivedAt   DateTime?
  depositedAt       DateTime?
  reconciledAt      DateTime?
  createdById       String                  @db.ObjectId
  pickedById        String?                 @db.ObjectId
  vaultReceivedById String?                 @db.ObjectId
  depositedById     String?                 @db.ObjectId
  reconciledById    String?                 @db.ObjectId
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run             CashCollectionRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  branch          Branch                @relation(fields: [branchId], references: [id])
  createdBy       User                  @relation("CashBagCreatedBy", fields: [createdById], references: [id])
  pickedBy        User?                 @relation("CashBagPickedBy", fields: [pickedById], references: [id])
  vaultReceivedBy User?                 @relation("CashBagVaultedBy", fields: [vaultReceivedById], references: [id])
  depositedBy     User?                 @relation("CashBagDepositedBy", fields: [depositedById], references: [id])
  reconciledBy    User?                 @relation("CashBagReconciledBy", fields: [reconciledById], references: [id])
  deposit         CashBankDeposit?
  events          CashCollectionEvent[]

  @@unique([companyId, bagCode])
  @@index([companyId, status])
  @@index([companyId, runId])
  @@index([companyId, branchId])
  @@index([companyId, createdAt])
  @@map("cash_collection_bags")
}

model CashBankDeposit {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId      String   @db.ObjectId
  bagId          String   @db.ObjectId
  depositNo      String
  bankAccountId  String?  @db.ObjectId
  bankAccountName String?  // Keep for backward compatibility
  depositSlipNo  String
  amount         Float
  depositDate    DateTime
  notes          String?
  createdById    String   @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bag         CashCollectionBag @relation(fields: [bagId], references: [id], onDelete: Cascade)
  bankAccount BankAccount?      @relation(fields: [bankAccountId], references: [id])
  createdBy   User              @relation("CashDepositCreatedBy", fields: [createdById], references: [id])

  @@unique([companyId, depositNo])
  @@unique([bagId])
  @@index([companyId, depositDate])
  @@index([bankAccountId])
  @@map("cash_bank_deposits")
}

model CashCollectionEvent {
  id         String                   @id @default(auto()) @map("_id") @db.ObjectId
  companyId  String                   @db.ObjectId
  runId      String?                  @db.ObjectId
  bagId      String?                  @db.ObjectId
  branchId   String?                  @db.ObjectId
  eventType  String
  fromStatus CashCollectionBagStatus?
  toStatus   CashCollectionBagStatus?
  amount     Float?
  notes      String?
  metadata   Json?
  actorId    String                   @db.ObjectId
  createdAt  DateTime                 @default(now())

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run     CashCollectionRun? @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bag     CashCollectionBag? @relation(fields: [bagId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch  Branch?            @relation(fields: [branchId], references: [id])
  actor   User               @relation("CashEventActor", fields: [actorId], references: [id])

  @@index([companyId, createdAt])
  @@index([runId])
  @@index([bagId])
  @@index([branchId])
  @@map("cash_collection_events")
}

model SalesReturn {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String            @db.ObjectId
  branchId    String            @db.ObjectId
  invoiceId   String            @db.ObjectId
  customerId  String?           @db.ObjectId
  returnNo    String
  subtotal    Float
  taxTotal    Float             @default(0)
  grandTotal  Float
  status      SalesReturnStatus @default(POSTED)
  reason      String?
  notes       String?
  createdById String            @db.ObjectId
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch            @relation(fields: [branchId], references: [id])
  invoice   POSInvoice        @relation(fields: [invoiceId], references: [id])
  customer  Customer?         @relation(fields: [customerId], references: [id])
  createdBy User              @relation("SalesReturnCreatedBy", fields: [createdById], references: [id])
  items     SalesReturnItem[]

  @@unique([companyId, returnNo])
  @@index([companyId, createdAt])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  returnId      String @db.ObjectId
  invoiceItemId String @db.ObjectId
  productId     String @db.ObjectId
  unitCode      String
  qty           Float
  unitPrice     Float
  discount      Float  @default(0)
  taxAmount     Float  @default(0)
  lineTotal     Float

  salesReturn SalesReturn    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  invoiceItem POSInvoiceItem @relation(fields: [invoiceItemId], references: [id])
  product     Product        @relation(fields: [productId], references: [id])

  @@map("sales_return_items")
}

model SalesQuotation {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  companyId          String               @db.ObjectId
  branchId           String               @db.ObjectId
  quotationNo        String
  customerId         String?              @db.ObjectId
  customerName       String?
  date               DateTime             @default(now())
  validUntil         DateTime?
  subtotal           Float
  taxTotal           Float                @default(0)
  discountTotal      Float                @default(0)
  grandTotal         Float
  status             SalesQuotationStatus @default(DRAFT)
