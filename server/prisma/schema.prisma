// ══════════════════════════════════════════════════════════════
// TRANSFERS
// ══════════════════════════════════════════════════════════════

model Transfer {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  companyId    String         @db.ObjectId
  fromBranchId String         @db.ObjectId
  toBranchId   String         @db.ObjectId
