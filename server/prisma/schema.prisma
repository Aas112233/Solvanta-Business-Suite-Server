  purchaseInvoice PurchaseInvoice      @relation(fields: [purchaseInvoiceId], references: [id])
  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  createdBy       User                 @relation("PurchaseReturnCreatedBy", fields: [createdById], references: [id])
  items           PurchaseReturnItem[]

  @@unique([companyId, returnNo])
  @@index([companyId, createdAt])
  @@index([companyId, supplierId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  returnId       String @db.ObjectId
  purchaseItemId String @db.ObjectId
  productId      String @db.ObjectId
  unitCode       String
  qty            Float
  unitCost       Float
  taxAmount      Float  @default(0)
  lineTotal      Float

  purchaseReturn PurchaseReturn      @relation(fields: [returnId], references: [id], onDelete: Cascade)
  purchaseItem   PurchaseInvoiceItem @relation(fields: [purchaseItemId], references: [id])
  product        Product             @relation(fields: [productId], references: [id])

  @@map("purchase_return_items")
}

model PurchasePayment {
  id                String                @id @default(auto()) @map("_id") @db.ObjectId
  companyId         String                @db.ObjectId
  branchId          String                @db.ObjectId
  purchaseInvoiceId String                @db.ObjectId
  supplierId        String                @db.ObjectId
  paymentNo         String
  paymentDate       DateTime              @default(now())
  amount            Float
  paymentMethod     String
  referenceNo       String?
  notes             String?
  status            PurchasePaymentStatus @default(POSTED)
  createdById       String                @db.ObjectId
  createdAt         DateTime              @default(now())
