}

// ══════════════════════════════════════════════════════════════
// ACCOUNTING
// ══════════════════════════════════════════════════════════════

model Account {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  companyId String      @db.ObjectId
  code      String
  name      String
  type      AccountType
  parentId  String?     @db.ObjectId
  isSystem  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Account?           @relation("AccountTree", fields: [parentId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  children Account[]          @relation("AccountTree")
  lines    JournalEntryLine[]
  mappings AccountMapping[]
  serviceIncomes ServiceMaster[] @relation("ServiceIncomeAccount")
  serviceExpenses ServiceMaster[] @relation("ServiceExpenseAccount")
  bankAccounts BankAccount[]

  @@unique([companyId, code])
  @@map("accounts")
}

model AccountMapping {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String             @db.ObjectId
  mappingType AccountMappingType
  entityType  AccountEntityType  @default(GLOBAL)
  entityId    String?            @db.ObjectId
  accountId   String             @db.ObjectId
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: NoAction)

  @@unique([companyId, mappingType, entityType, entityId])
  @@index([companyId, mappingType])
  @@map("account_mappings")
}

model JournalEntry {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId    String   @db.ObjectId
  branchId     String?  @db.ObjectId
  costCenterId String?  @db.ObjectId
  entryNo      String
  date         DateTime
  memo         String?
  sourceType   String?
  sourceId     String?
  postedById   String   @db.ObjectId
  postedAt     DateTime @default(now())
  isReversed   Boolean  @default(false)
  createdAt    DateTime @default(now())

  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch?            @relation(fields: [branchId], references: [id])
  costCenter      Branch?            @relation("JournalEntryCostCenter", fields: [costCenterId], references: [id])
  postedBy        User               @relation("JournalPostedBy", fields: [postedById], references: [id])
  lines           JournalEntryLine[]
  expensePurchase ExpensePurchase?
  bankTransactions BankTransaction[]
  payrollPayments  PayrollPayment[]

  @@unique([companyId, entryNo])
  @@index([companyId, sourceType, sourceId])
  @@index([companyId, date])
  @@index([companyId, branchId, date])
