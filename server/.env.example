# Server runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=5001

# Database
DATABASE_URL=mongodb://127.0.0.1:27017/enterprise_erp

# CORS
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-second-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug

# Super admin bootstrapping
SUPER_ADMIN_EMAILS=owner@example.com
SUPER_ADMIN_EMAIL=owner@example.com
