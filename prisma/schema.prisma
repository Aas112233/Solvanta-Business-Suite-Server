// ─── Prisma Schema: Enterprise CRM + ERP + POS + Accounting (MongoDB) ───
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════════════════════

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum TaxType {
  SALES
  PURCHASE
  BOTH
}

enum StockMovementType {
  PURCHASE_RECEIPT
  POS_SALE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  DAMAGE
  EXPIRED
  RETURN
}

enum PaymentMethod {
  CASH
  CARD
  MIXED
  CREDIT
  BANK_TRANSFER
}

enum InvoiceStatus {
  PAID
  PARTIAL
  CREDIT
  VOID
  REFUNDED
  UNPOSTED
}

enum SalesReturnStatus {
  POSTED
  VOID
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  PARTIAL
  PAID
  CANCELLED
}

enum PurchaseReturnStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  ORDERED
  RECEIVED
  PARTIAL
  CANCELLED
}

enum PurchasePaymentStatus {
  POSTED
  VOID
}

enum TransferStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum PartyType {
  CUSTOMER
  SUPPLIER
}

enum AccountMappingType {
  INVENTORY_ASSET
  COGS_EXPENSE
  SALES_REVENUE
  SALES_RETURN
  OUTPUT_TAX
  INPUT_TAX
  CASH
  BANK
  ACCOUNT_PAYABLE
  ACCOUNT_RECEIVABLE
  PURCHASE_RETURN
  EXPENSE
  DISCOUNT_GIVEN
  DISCOUNT_RECEIVED
  SHRINKAGE_EXPENSE
  DAMAGED_GOODS_EXPENSE
  TRANSFER_IN_TRANSIT
}

enum AccountEntityType {
  GLOBAL
  BRANCH
  PRODUCT
  CATEGORY
  CUSTOMER
  SUPPLIER
}

enum StockCountStatus {
  DRAFT
  PENDING
  COMMITTED
  CANCELLED
}

enum POSShiftStatus {
  OPEN
  CLOSED
}

enum SalesQuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  EXPIRED
  REJECTED
  CONVERTED
  CANCELLED
}

enum CashCollectionRunStatus {
  DRAFT
  IN_PROGRESS
  CLOSED
  CANCELLED
}

enum CashCollectionBagStatus {
  DECLARED
  PICKUP_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  VAULT_RECEIVED
  DEPOSITED
  RECONCILED
  SHORT
  EXCESS
  LOST
  CANCELLED
}

// ══════════════════════════════════════════════════════════════
// COMPANY & BRANCH
// ══════════════════════════════════════════════════════════════

model Company {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  vatNumber String?
  currency  String   @default("SAR")
  settings  Json
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches         Branch[]
  users            User[]
  roles            Role[]
  customers        Customer[]
  suppliers        Supplier[]
  categories       Category[]
  brands           Brand[]
  itemGroups       ItemGroup[]
  unitMasters      UnitMaster[]
  products         Product[]
  taxes            Tax[]
  priceGroups      PriceGroup[]
  accounts         Account[]
  accountMappings  AccountMapping[]
  journalEntries   JournalEntry[]
  posInvoices      POSInvoice[]
  salesReturns     SalesReturn[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]
  purchasePayments PurchasePayment[]
  transfers        Transfer[]
  inventoryStocks  InventoryStock[]
  stockMovements   StockMovement[]
  expenses         Expense[]
  periodCloses     PeriodClose[]
  stockCounts      StockCount[]
  auditLogs        AuditLog[]
  globalStrings    GlobalString[]
  documentCounters DocumentCounter[]
  posTerminals     POSTerminal[]
  posShifts        POSShift[]
  purchaseOrders   PurchaseOrder[]
  salesQuotations  SalesQuotation[]
  salesOrders      SalesOrder[]
  cashCollectionRuns CashCollectionRun[]
  cashCollectionBags CashCollectionBag[]
  cashBankDeposits   CashBankDeposit[]
  cashCollectionEvents CashCollectionEvent[]
  loyaltyCustomers   LoyaltyCustomer[]
  loyaltyPointHistory LoyaltyPointHistory[]

  defaultTaxAccountId        String? @db.ObjectId

  @@index([createdAt])
  @@map("companies")
}

model DocumentCounter {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId  String   @db.ObjectId
  scope      String
  scopeKey   String   @default("global")
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, scope, scopeKey])
  @@map("document_counters")
}

model Branch {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @db.ObjectId
  name      String
  code      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userBranches     UserBranch[]
  inventoryStocks  InventoryStock[]
  stockMovements   StockMovement[]
  posInvoices      POSInvoice[]
  salesReturns     SalesReturn[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]
  purchasePayments PurchasePayment[]
  journalEntries   JournalEntry[]
  journalCostCenters JournalEntry[]    @relation("JournalEntryCostCenter")
  expenses         Expense[]
  transfersFrom    Transfer[]        @relation("TransferFrom")
  transfersTo      Transfer[]        @relation("TransferTo")
  stockCounts      StockCount[]
  auditLogs        AuditLog[]
  posTerminals     POSTerminal[]
  purchaseOrders   PurchaseOrder[]
  salesQuotations  SalesQuotation[]
  salesOrders      SalesOrder[]
  cashCollectionBags CashCollectionBag[]
  cashCollectionEvents CashCollectionEvent[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

// ══════════════════════════════════════════════════════════════
// USER & ROLE (RBAC)
// ══════════════════════════════════════════════════════════════

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String   @db.ObjectId
  name        String
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users   User[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  companyId    String    @db.ObjectId
  email        String    @unique
  phone        String?
  name         String
  passwordHash String
  roleId       String    @db.ObjectId
  isActive     Boolean   @default(true)
  refreshToken String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company              Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role                 Role              @relation(fields: [roleId], references: [id])
  branches             UserBranch[]
  posInvoices          POSInvoice[]      @relation("CreatedBy")
  salesReturns         SalesReturn[]     @relation("SalesReturnCreatedBy")
  purchaseInvoices     PurchaseInvoice[] @relation("PurchaseCreatedBy")
  purchaseReturns      PurchaseReturn[]  @relation("PurchaseReturnCreatedBy")
  purchasePayments     PurchasePayment[] @relation("PurchasePaymentCreatedBy")
  stockMovements       StockMovement[]   @relation("MovementCreatedBy")
  journalEntries       JournalEntry[]    @relation("JournalPostedBy")
  expenses             Expense[]         @relation("ExpenseCreatedBy")
  periodCloses         PeriodClose[]     @relation("PeriodClosedBy")
  transfersCreated     Transfer[]        @relation("TransferCreatedBy")
  transfersApproved    Transfer[]        @relation("TransferApprovedBy")
  stockCountsCreated   StockCount[]      @relation("StockCountCreatedBy")
  stockCountsCommitted StockCount[]      @relation("StockCountCommittedBy")
  auditLogs            AuditLog[]
  posShifts            POSShift[]        @relation("ShiftUser")
  purchaseOrders       PurchaseOrder[]   @relation("PurchaseOrderCreatedBy")
  posTerminals         POSTerminal[]     @relation("TerminalDefaultUser")
  salesQuotations      SalesQuotation[]  @relation("QuotationCreatedBy")
  salesOrders          SalesOrder[]      @relation("SalesOrderCreatedBy")
  cashRunsCreated      CashCollectionRun[] @relation("CashRunCreatedBy")
  cashRunsCollected    CashCollectionRun[] @relation("CashRunCollector")
  cashBagsCreated      CashCollectionBag[] @relation("CashBagCreatedBy")
  cashBagsPicked       CashCollectionBag[] @relation("CashBagPickedBy")
  cashBagsVaulted      CashCollectionBag[] @relation("CashBagVaultedBy")
  cashBagsDeposited    CashCollectionBag[] @relation("CashBagDepositedBy")
  cashBagsReconciled   CashCollectionBag[] @relation("CashBagReconciledBy")
  cashDeposits         CashBankDeposit[]   @relation("CashDepositCreatedBy")
  cashCollectionEvents CashCollectionEvent[] @relation("CashEventActor")

  @@index([companyId, email])
  @@map("users")
}

model UserBranch {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  userId   String @db.ObjectId
  branchId String @db.ObjectId

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("user_branches")
}

// ══════════════════════════════════════════════════════════════
// CRM: CUSTOMER & SUPPLIER
// ══════════════════════════════════════════════════════════════

model Customer {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  companyId      String    @db.ObjectId
  customerCode   String
  name           String
  phone          String?
  email          String?
  vatNumber      String?
  address        Json?
  creditLimit    Float     @default(0)
  allowCreditSales Boolean  @default(true)
  openingBalance Float     @default(0)
  priceGroupId   String?   @db.ObjectId
  tags           String[]
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceGroup      PriceGroup?      @relation(fields: [priceGroupId], references: [id])
  posInvoices     POSInvoice[]
  salesReturns    SalesReturn[]
  salesQuotations SalesQuotation[]
  salesOrders     SalesOrder[]

  @@unique([companyId, customerCode])
  @@index([companyId, deletedAt])
  @@map("customers")
}

model Supplier {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  companyId      String    @db.ObjectId
  supplierCode   String
  name           String
  phone          String?
  vatNumber      String?
  address        Json?
  openingBalance Float     @default(0)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseInvoices PurchaseInvoice[]
  purchaseOrders   PurchaseOrder[]
  purchaseReturns  PurchaseReturn[]
  purchasePayments PurchasePayment[]

  @@unique([companyId, supplierCode])
  @@index([companyId, deletedAt])
  @@map("suppliers")
}

// ══════════════════════════════════════════════════════════════
// PRODUCT CATALOG & TAXES
// ══════════════════════════════════════════════════════════════

model Tax {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String   @db.ObjectId
  name        String
  rate        Float    // e.g. 0.15 for 15%
  type        TaxType  @default(BOTH)
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("taxes")
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @db.ObjectId
  name      String
  parentId  String?  @db.ObjectId
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("categories")
}

model ItemGroup {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @db.ObjectId
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("item_groups")
}

model Brand {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @db.ObjectId
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("brands")
}

model UnitMaster {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId            String   @db.ObjectId
  name                 String
  defaultQtyInBaseUnit Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("unit_masters")
}

model Product {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String        @db.ObjectId
  itemCode    String // 16 digits
  name        String
  nameArabic  String?
  categoryId  String?       @db.ObjectId
  itemGroupId String?       @db.ObjectId
  brandId     String?       @db.ObjectId
  barcodes    String[]

  taxId       String?       @db.ObjectId
  taxRate     Float         @default(0.15) // Legacy field, keeping for fallback
  status      ProductStatus @default(ACTIVE)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category             Category?             @relation(fields: [categoryId], references: [id])
  itemGroup            ItemGroup?            @relation(fields: [itemGroupId], references: [id])
  brand                Brand?                @relation(fields: [brandId], references: [id])
  tax                  Tax?                  @relation(fields: [taxId], references: [id])
  units                ProductUnit[]
  priceGroupPrices     ProductPriceGroup[]
  inventoryStocks      InventoryStock[]
  stockMovements       StockMovement[]
  posInvoiceItems      POSInvoiceItem[]
  salesReturnItems     SalesReturnItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  purchaseOrderItem    PurchaseOrderItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  transferItems        TransferItem[]
  stockCountItems      StockCountItem[]
  salesQuotationItems  SalesQuotationItem[]
  salesOrderItems      SalesOrderItem[]

  @@unique([companyId, itemCode])
  @@index([companyId, deletedAt])
  @@index([companyId, status])
  @@map("products")
}

model ProductUnit {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  productId         String  @db.ObjectId
  unitName          String
  unitCode          String
  qtyInBaseUnit     Float   @default(1)
  salePrice         Float   @default(0)
  costPrice         Float   @default(0)
  barcode           String?
  isDefaultSaleUnit Boolean @default(false)
  isBase            Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, unitCode])
  @@index([productId])
  @@index([barcode])
  @@map("product_units")
}

model PriceGroup {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId String   @db.ObjectId
  name      String
  code      String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productPriceGroups ProductPriceGroup[]
  customers          Customer[]
  posTerminals       POSTerminal[]

  @@unique([companyId, name])
  @@map("price_groups")
}

model ProductPriceGroup {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  productId    String @db.ObjectId
  priceGroupId String @db.ObjectId
  unitCode     String
  salePrice    Float

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceGroup PriceGroup @relation(fields: [priceGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, priceGroupId, unitCode])
  @@map("product_price_groups")
}

// ══════════════════════════════════════════════════════════════
// INVENTORY
// ══════════════════════════════════════════════════════════════

model InventoryStock {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  companyId String    @db.ObjectId
  branchId  String    @db.ObjectId
  productId String    @db.ObjectId
  unitCode  String
  qtyOnHand Float     @default(0)
  avgCost   Float     @default(0)

  minStock  Float     @default(5)
  maxStock  Float     @default(100)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([branchId, productId, unitCode])
  @@index([companyId])
  @@index([companyId, productId])
  @@index([companyId, branchId])

  @@map("inventory_stocks")
}

model StockMovement {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  companyId     String            @db.ObjectId
  branchId      String            @db.ObjectId
  type          StockMovementType
  referenceId   String?
  referenceType String?
  productId     String            @db.ObjectId
  unitCode      String
  qty           Float
  cost          Float             @default(0)
  price         Float             @default(0)

  createdById   String            @db.ObjectId
  createdAt     DateTime          @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch  @relation(fields: [branchId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation("MovementCreatedBy", fields: [createdById], references: [id])

  @@index([companyId, productId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ══════════════════════════════════════════════════════════════
// POS INVOICES
// ══════════════════════════════════════════════════════════════

model POSInvoice {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  companyId     String        @db.ObjectId
  branchId      String        @db.ObjectId
  invoiceNo     String
  customerId    String?       @db.ObjectId
  posTerminalId String?       @db.ObjectId
  posShiftId    String?       @db.ObjectId
  salesOrderId  String?       @db.ObjectId
  subtotal      Float
  discountTotal Float         @default(0)
  taxTotal      Float         @default(0)
  grandTotal    Float
  paymentMethod String
  cashReceived  Float         @default(0)
  changeGiven   Float         @default(0)
  status        InvoiceStatus @default(PAID)
  isPosted      Boolean       @default(true)
  notes         String?
  createdById   String        @db.ObjectId
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  loyaltyCustomerId   String?           @db.ObjectId
  loyaltyPointsEarned   Float?          @default(0)
  loyaltyPointsRedeemed Float?          @default(0)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch      Branch           @relation(fields: [branchId], references: [id])
  customer    Customer?        @relation(fields: [customerId], references: [id])
  createdBy   User             @relation("CreatedBy", fields: [createdById], references: [id])
  posTerminal POSTerminal?     @relation(fields: [posTerminalId], references: [id])
  posShift    POSShift?        @relation(fields: [posShiftId], references: [id])
  salesOrder  SalesOrder?      @relation(fields: [salesOrderId], references: [id])
  loyaltyCustomer     LoyaltyCustomer?  @relation(fields: [loyaltyCustomerId], references: [id])
  loyaltyPointHistory LoyaltyPointHistory[]
  items       POSInvoiceItem[]
  returns     SalesReturn[]

  @@unique([companyId, invoiceNo])
  @@index([companyId, createdAt])
  @@index([customerId])
  @@index([posShiftId])
  @@index([salesOrderId])
  @@map("pos_invoices")
}

model POSInvoiceItem {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId String    @db.ObjectId
  productId String    @db.ObjectId
  unitCode  String
  qty       Float
  unitPrice Float
  discount  Float     @default(0)
  taxAmount Float     @default(0)
  lineTotal Float


  invoice     POSInvoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id])
  returnItems SalesReturnItem[]

  @@map("pos_invoice_items")
}

// ══════════════════════════════════════════════════════════════
// LOYALTY & WALK-IN CUSTOMERS
// ══════════════════════════════════════════════════════════════

enum LoyaltyPointType {
  EARNED
  REDEEMED
  ADJUSTMENT
}

model LoyaltyCustomer {
  id             String                @id @default(auto()) @map("_id") @db.ObjectId
  companyId      String                @db.ObjectId
  name           String
  phone          String
  pointsBalance  Float                 @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices       POSInvoice[]
  pointHistory   LoyaltyPointHistory[]

  @@unique([companyId, phone])
  @@index([companyId, name])
  @@map("pos_loyalty_customers")
}

model LoyaltyPointHistory {
  id              String               @id @default(auto()) @map("_id") @db.ObjectId
  companyId       String               @db.ObjectId
  customerId      String               @db.ObjectId
  invoiceId       String?              @db.ObjectId
  pointsChange    Float
  type            LoyaltyPointType
  notes           String?
  createdAt       DateTime             @default(now())

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        LoyaltyCustomer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice         POSInvoice?          @relation(fields: [invoiceId], references: [id])

  @@index([companyId, customerId])
  @@map("pos_loyalty_point_history")
}

// ══════════════════════════════════════════════════════════════
// POS TERMINALS & SHIFTS
// ══════════════════════════════════════════════════════════════

model POSTerminal {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId     String   @db.ObjectId
  code          String
  name          String
  branchId      String   @db.ObjectId
  defaultUserId String?  @db.ObjectId
  priceGroupId  String?  @db.ObjectId
  receiptHeader String?
  receiptFooter String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch      Branch       @relation(fields: [branchId], references: [id])
  defaultUser User?        @relation("TerminalDefaultUser", fields: [defaultUserId], references: [id])
  priceGroup  PriceGroup?  @relation(fields: [priceGroupId], references: [id])
  shifts      POSShift[]
  invoices    POSInvoice[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("pos_terminals")
}

model POSShift {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  companyId         String         @db.ObjectId
  terminalId        String         @db.ObjectId
  userId            String         @db.ObjectId
